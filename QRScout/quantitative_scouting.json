          "defaultValue": "",
          "choices": {
            "C": "Close",
            "M": "Middle",
            "F": "Far"
          }
        }
      ]
    },
    {
      "name": "Autonomous",
      "fields": [
        {
          "title": "Type of Auto",
          "description": "Check which zone(s) the robot intaked during auto.",
          "type": "multi-select",
          "required": false,
          "code": "typeAuto",
          "formResetBehavior": "reset",
          "choices": {
            "1": "Depot",
            "2": "Outpost/HP",
            "3": "Left Trench",
            "4": "Left Bump",
            "5": "Right Trench",
            "6": "Right Bump"
          }
        },
        {
          "title": "Bump",
          "description": "Check if the robot went over the bump at least once during auto.",
          "type": "boolean",
          "required": false,
          "code": "bumpAuto",
          "formResetBehavior": "reset",
          "defaultValue": false
        },
        {
          "title": "Amount of Full Hoppers (Tenths)",
          "description": "How much fuel the robot held compared to the total possible fuel it can hold.",
          "type": "counter",
          "required": false,
          "code": "hopcapAuto",
          "formResetBehavior": "reset",
          "defaultValue": 0,
          "min": 0,
          "max": 20,
          "step": 1
        }
      ]
    },
    {
      "name": "Teleop",
      "fields": [
        {
          "title": "Trench",
          "description": "Count how many times the robot went under the trench.",
          "type": "counter",
          "required": false,
          "code": "trenchTele",
          "formResetBehavior": "reset",
          "defaultValue": 0,
          "min": 0,
          "max": 1000,
          "step": 1
        },
        {
          "title": "Bump",
          "description": "Count how many times the robot went over the bump.",
          "type": "counter",
          "required": false,
          "code": "bumpTele",
          "formResetBehavior": "reset",
          "defaultValue": 0,
          "min": 0,
          "max": 1000,
          "step": 1
        },
        {
          "title": "Number of Full Hoppers",
          "description": "Count number of full hoppers the robot scored into the hub.",
          "type": "counter",
          "required": false,
          "code": "numCycles",
          "formResetBehavior": "reset",
          "defaultValue": 0,
          "min": 0,
          "max": 1000,
          "step": 1
        },
        {
          "title": "Partial of a Full Hopper (Tenths)",
          "description": "More descriptive count of full hopper count. Measured in tenths.",
          "type": "range",
          "required": false,
          "code": "cycles",
          "formResetBehavior": "reset",
          "defaultValue": 0,
          "min": 0,
          "max": 9,
          "step": 1
        }
      ]
    },
    {
      "name": "Endgame",
      "fields": [
          {
          "title": "Climb <5 sec",
          "description": "Check if the robot climbed in less than five seconds.",
          "type": "boolean",
          "required": false,
          "code": "climbTime",
          "formResetBehavior": "reset",
          "defaultValue": false
        }
      ]
    },
    {
      "name": "Postmatch",
      "fields": [
        {
          "title": "Inactive Strategy",
          "description": "Strategy the robot played during their inactive shifts.",
          "type": "multi-select",
          "required": false,
          "code": "inactiveStrat",
          "formResetBehavior": "reset",
          "choices": {
            "1": "Pass",
            "2": "Herd/Bulldoze",
            "3": "Thief",
            "4": "Defense(OZ)",
            "5": "Defense(NZ)",
            "6": "Intaked Full"
          }
        },
        {
          "title": "Driver Rating",
          "description": "How well did the driver perform.",
          "type": "range",
          "required": false,
          "code": "driverRating",
          "formResetBehavior": "reset",
          "defaultValue": 1,
          "min": 1,
          "max": 5,
          "step": 1
        },
        {
          "title": "Problems?",
          "description": "Please indicate whether the robot died, got beached (stuck on fuel), surfing (slid over fuel), got stuck on bump, or did not show up.",
          "type": "multi-select",
          "required": false,
          "code": "died",
          "formResetBehavior": "reset",
          "choices": {
            "1": "Died",
            "2": "Beached",
            "3": "Surfing",
            "4": "Stuck on bump",
            "5": "No Show",
            "6": "Browned Out",
            "7": "A-Stop",
            "8": "E-Stop"
          }
        },
        {
          "title": "Yellow/Red Card",
          "type": "select",
          "required": true,
          "code": "card",
          "formResetBehavior": "reset",
          "defaultValue": "No Card",
          "choices": {
            "No Card": "No Card",
            "Yellow": "Yellow Card",
            "Red": "Red Card"
          }
        },
        {
          "title": "Comments",
          "type": "text",
          "required": false,
          "code": "comments",
          "formResetBehavior": "reset",
          "defaultValue": "",
          "min": 0,
          "max": 10000
        }
      ]
    }
  ]
